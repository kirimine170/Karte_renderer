{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirimine170/Karte_renderer/blob/main/docs/karte-format-v0.1.schema.json",
  "title": "Karte Format package manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "version", "markdown", "marp", "assets"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "markdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "styles"],
      "properties": {
        "layout": {
          "$ref": "#/$defs/packagePath"
        },
        "styles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/packagePath"
          }
        }
      }
    },
    "marp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultTheme", "themes"],
      "properties": {
        "defaultTheme": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "themes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/packagePath"
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory"],
      "properties": {
        "directory": {
          "$ref": "#/$defs/packagePath"
        }
      }
    }
  },
  "$defs": {
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!\\.?/?$)(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\/$)(?!.*\\x00).+$"
    }
  }
}
